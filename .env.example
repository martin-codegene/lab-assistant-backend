# Database
DATABASE_URL="postgresql://username:password@localhost:5432/lab_assistant_db"

# JWT Secret (for authentication)
JWT_SECRET=your-super-secret-jwt-secret-key-change-in-production

# AWS Configuration (for S3, etc.)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name

# Application
NODE_ENV=development
PORT=3000
API_VERSION=v1

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password

# File Upload
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# AI Service (Amazon Nova)
NOVA_API_KEY=your_nova_api_key_here
NOVA_API_BASE_URL=https://api.nova.ai/v1

# Redis (for caching)
REDIS_URL=redis://localhost:6379

# Rate Limiting
RATE_LIMIT_WINDOW=900000  # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100  # Max requests per window

# Amazon Nova AI Service Configuration
# Get your credentials from AWS Console: https://console.aws.amazon.com/
AMAZON_NOVA_API_KEY="your-amazon-nova-api-key"
AMAZON_NOVA_REGION="us-east-1"
AMAZON_NOVA_ENDPOINT="https://api.nova.amazonaws.com"

# Amazon Nova Model Selection
AMAZON_NOVA_MULTIMODAL_MODEL="nova-multimodal-v1"  # For image analysis
AMAZON_NOVA_TEXT_MODEL="nova-2-lite"                # For text analysis
AMAZON_NOVA_VOICE_MODEL="nova-2-sonic"              # For voice interactions
