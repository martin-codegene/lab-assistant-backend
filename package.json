{
  "name": "lab-assistant",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun --filter @lab-assistant/api dev",
    "dev:mobile": "bun --filter @lab-assistant/mobile start",
    "ios": "bun --filter @lab-assistant/mobile ios",
    "android": "bun --filter @lab-assistant/mobile android",
    "build:api": "bun --filter @lab-assistant/api build",
    "deploy:api": "bun --filter @lab-assistant/api deploy",
    "lint:mobile": "bun --filter @lab-assistant/mobile lint",
    "eas": "bun run --cwd apps/mobile eas",
    "eas:build:dev": "bun run --cwd apps/mobile build:dev",
    "eas:build:sim": "bun run --cwd apps/mobile build:dev:sim",
    "eas:build:preview": "bun run --cwd apps/mobile build:preview",
    "eas:build:prod": "bun run --cwd apps/mobile build:prod",
    "eas:submit": "bun run --cwd apps/mobile submit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "resolutions": {
    "lightningcss": "1.30.1"
  }
}
