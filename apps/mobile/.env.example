# ─────────────────────────────────────────────────────────────────────────────
# Lab App — Environment Variables
#
# Copy this file to .env.local (or .env) and fill in the values below.
# Variables prefixed with EXPO_PUBLIC_ are bundled into the client app and
# accessible via process.env at runtime.
# ─────────────────────────────────────────────────────────────────────────────

# ── Nova AI (chat + voice transcription) ─────────────────────────────────────
# Required for the Lab Assistant AI chat and Voice Lab Mode features.
# Used with model: nova-2-sonic-v1
# Get your key at https://api.nova.amazon.com
EXPO_PUBLIC_NOVA_API_KEY=

# ── Backend API ───────────────────────────────────────────────────────────────
# Base URL for the Lab App backend (including /api suffix).
# Defaults to the ngrok tunnel defined in lib/api.ts — override here if needed.
# EXPO_PUBLIC_API_BASE_URL=https://your-backend.example.com/api
